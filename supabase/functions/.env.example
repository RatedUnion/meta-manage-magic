# Social publishing integrations (server-side only)
META_APP_ID=
META_APP_SECRET=
# Exact callback URL registered in Meta Developer Console, e.g.
# https://<project-ref>.supabase.co/functions/v1/meta-oauth-callback
META_REDIRECT_URI=
# Keep this set to a currently supported Meta Graph API version.
META_GRAPH_API_VERSION=
META_APP_URL=https://meta-manage-magic.lovable.app
META_ALLOWED_ORIGINS=https://meta-manage-magic.lovable.app
# 32 random bytes, base64-encoded. Store as a Supabase Edge Function secret.
META_TOKEN_ENCRYPTION_KEY=
